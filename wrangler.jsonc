// Cloudflare ayari: revorapdf.com sitesi = sadece website/ klasoru (statik dosyalar).
// Deponun geri kalani (programin kodu) siteye CIKMAZ. GitHub'a her gonderimde yeniden yayinlanir.
{
  "name": "revorapdf",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./website",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // site sadece kendi alan adindan acilsin (gecici *.workers.dev adresinde hesap adi gorunuyordu)
  "routes": [
    { "pattern": "revorapdf.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
